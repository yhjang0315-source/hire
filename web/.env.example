# 고용24 Open API 인증키 (https://www.work24.go.kr → 고객센터 → OPEN-API에서 신청)
WORK24_WANTED_KEY=
WORK24_JOB_KEY=
WORK24_TRAINING_KEY=
# 고용행정통계 Open API 인증키 (https://eis.work24.go.kr)
EIS_KEY=

# 앱이 읽을 데이터: mock(기본) | cache(npm run collect 결과)
DATA_SOURCE=mock

# 명세 확인 후 URL을 바꿔야 하면 덮어쓴다 (예: POSTINGSLIST_URL=https://...)
